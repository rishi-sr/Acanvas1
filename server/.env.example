# ==========================================
# AKSHAR CANVAS - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# 1. Server Environment
PORT=5000
NODE_ENV=production

# 2. Database (MongoDB Atlas) - Required for cloud deployments
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/akshar_canvas?retryWrites=true&w=majority

# 3. Security & Authentication (JWT)
JWT_SECRET=akshar_canvas_super_secret_jwt_key_2026_xyz_replace_with_strong_random_secret
JWT_EXPIRES_IN=7d

# 4. Admin Login Credentials
ADMIN_USERNAME=aksharcanva
ADMIN_PASSWORD=Akshar@2026

# 5. CORS Allowed Origins (Comma-separated list of frontend URLs)
# Add your Vercel URL and any custom domains
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5174,http://localhost:5173

# 6. Cloudinary (Persistent storage for photos & images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Email Notifications (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-16-digit-app-password
SMTP_SECURE=false
ADMIN_NOTIFICATION_EMAIL=admin@aksharcanvas.com
EMAIL_FROM="Akshar Canvas Literary Portal" <notifications@aksharcanvas.com>

# 8. Optional: EmailJS fallback
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
