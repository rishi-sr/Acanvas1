# ========================================================
# Akshar Canvas — Master Backend Environment Configuration
# ========================================================

# Server Port & Runtime
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174,http://localhost:5173,http://localhost:3000

# 1. MongoDB Database URI
# (Leave blank to use local zero-config persistent database)
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/aksharcanvas?retryWrites=true&w=majority
MONGODB_URI=

# 2. Cloudinary Media Storage (For author portraits & book covers)
# (Leave blank to use local /uploads storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 3. Security & Admin Authentication (JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=akshar2026
JWT_SECRET=akshar_canvas_super_secret_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d

# 4. Email Notification Dispatcher (SMTP / Nodemailer)
# (Leave blank to use server console mock logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=admin@aksharcanvas.com
EMAIL_FROM="Akshar Canvas Literary Portal" <notifications@aksharcanvas.com>

# 5. Optional EmailJS Integration
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

